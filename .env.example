# Copy this file to .env and fill in your values.
# .env is git-ignored and should never be committed.

# The Ollama model(s) to use, comma-separated (e.g. granite4.2:8b,llama3.2,mistral,llava:7b).
# Must match models you have pulled locally.
# Run `ollama list` to see what is available on your machine.
# Browse all models at https://ollama.com/library
OLLAMA_MODEL=granite4.2:8b,llava:7b
